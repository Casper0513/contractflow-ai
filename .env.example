# ============================================================
# ContractFlow
# ============================================================

# Runtime
NODE_ENV=development
PORT=4000

# Web application origin used by API CORS and generated links.
WEB_URL=http://localhost:3000

# Public API base URL used by the Next.js web application.
# ContractFlow's Nest API uses the global /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api


# ============================================================
# Database
# ============================================================

DATABASE_URL=postgresql://contractflow:change-me@localhost:5432/contractflow?schema=public


# ============================================================
# Clerk authentication
# ============================================================

# Browser-safe Clerk publishable key used by Next.js.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk publishable key used by the API.
# This is normally the same publishable key as above.
CLERK_PUBLISHABLE_KEY=

# Server-only Clerk secret.
CLERK_SECRET_KEY=


# ============================================================
# Email / Resend
# ============================================================

RESEND_API_KEY=

# Example:
# EMAIL_FROM=ContractFlow <notifications@example.com>
EMAIL_FROM=


# ============================================================
# Stripe
# ============================================================

# Server-only Stripe secret key.
STRIPE_SECRET_KEY=

# Webhook secret for invoice payment events.
STRIPE_WEBHOOK_SECRET=

# Webhook secret for ContractFlow SaaS subscription billing.
# Required in production.
STRIPE_BILLING_WEBHOOK_SECRET=

# SaaS subscription price IDs.
# All are required in production.
STRIPE_BILLING_STARTER_MONTHLY_PRICE_ID=
STRIPE_BILLING_STARTER_ANNUAL_PRICE_ID=

STRIPE_BILLING_PRO_MONTHLY_PRICE_ID=
STRIPE_BILLING_PRO_ANNUAL_PRICE_ID=

STRIPE_BILLING_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_BILLING_BUSINESS_ANNUAL_PRICE_ID=


# ============================================================
# S3-compatible object storage
# ============================================================

# Optional.
#
# ContractFlow supports Cloudflare R2, AWS S3, MinIO,
# Backblaze B2 S3, and other S3-compatible providers.
#
# If object storage is enabled, endpoint, bucket, access key,
# and secret key must all be configured.

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ============================================================
# OpenAI
# ============================================================

# Optional. AI functionality is unavailable when no key is set.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-5.6
