{
  "name": "@contractflow/db-prisma8",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.23.13",
    "tsup": "^8.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
