// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.
namespace public {
  model Organization {
    id                       String                    @id(map: "Organization_pkey") @default(cuid(2))
    name                     String
    slug                     String
    legalName                String?
    email                    String?
    phone                    String?
    timezone                 String                    @default("America/Edmonton")
    currency                 String                    @default("CAD")
    createdAt                Timestamp(3)              @default(now())
    updatedAt                Timestamp(3)
    nextEstimateNumber       Int                       @default(1)
    nextInvoiceNumber        Int                       @default(1)
    addressLine1             String?
    addressLine2             String?
    city                     String?
    country                  String                    @default("CA")
    logoUrl                  String?
    postalCode               String?
    province                 String?
    taxNumber                String?
    website                  String?
    billingSubscription      BillingSubscription?
    checklistTemplates       ChecklistTemplate[]
    crewMembers              CrewMember[]
    customers                Customer[]
    customerActivities       CustomerActivity[]
    customerCommunications   CustomerCommunication[]
    customerInternalNotes    CustomerInternalNote[]
    dispatchSettings         DispatchSettings?
    estimates                Estimate[]
    estimateReminders        EstimateReminder[]
    estimateReminderSettings EstimateReminderSettings?
    invoices                 Invoice[]
    invoiceReminders         InvoiceReminder[]
    invoiceReminderSettings  InvoiceReminderSettings?
    jobs                     Job[]
    jobChecklists            JobChecklist[]
    jobChecklistItems        JobChecklistItem[]
    jobContacts              JobContact[]
    jobCosts                 JobCost[]
    jobDocuments             JobDocument[]
    jobMaterials             JobMaterial[]
    jobNotes                 JobNote[]
    jobPhotos                JobPhoto[]
    jobSchedules             JobSchedule[]
    jobScheduleCrewMembers   JobScheduleCrewMember[]
    jobTasks                 JobTask[]
    jobTimeEntries           JobTimeEntry[]
    memberships              Membership[]
    notifications            Notification[]
    payments                 Payment[]

    @@index([slug], map: "Organization_slug_key", unique: true)
    @@map("Organization")
  }

  model BillingSubscription {
    id                   String                             @id(map: "BillingSubscription_pkey") @default(cuid(2))
    organizationId       String
    plan                 pg.enum(BillingPlan)
    status               pg.enum(BillingSubscriptionStatus)
    stripeCustomerId     String
    stripeSubscriptionId String
    stripePriceId        String
    currentPeriodStart   Timestamp(3)?
    currentPeriodEnd     Timestamp(3)?
    cancelAtPeriodEnd    Boolean                            @default(false)
    canceledAt           Timestamp(3)?
    trialEnd             Timestamp(3)?
    createdAt            Timestamp(3)                       @default(now())
    updatedAt            Timestamp(3)
    interval             pg.enum(BillingInterval)           @default("MONTHLY")
    organization         Organization                       @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "BillingSubscription_organizationId_fkey")

    @@unique([organizationId], map: "BillingSubscription_organizationId_key")
    @@index([plan], map: "BillingSubscription_plan_idx")
    @@index([status], map: "BillingSubscription_status_idx")
    @@index([stripeCustomerId], map: "BillingSubscription_stripeCustomerId_key", unique: true)
    @@index([stripePriceId], map: "BillingSubscription_stripePriceId_idx")
    @@index([stripeSubscriptionId], map: "BillingSubscription_stripeSubscriptionId_key", unique: true)
    @@map("BillingSubscription")
  }

  model ChecklistTemplate {
    id                     String                  @id(map: "ChecklistTemplate_pkey") @default(cuid(2))
    organizationId         String
    name                   String
    description            String?
    active                 Boolean                 @default(true)
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    checklistTemplateItems ChecklistTemplateItem[]
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "ChecklistTemplate_organizationId_fkey")

    @@index([organizationId, active], map: "ChecklistTemplate_organizationId_active_idx")
    @@index([organizationId], map: "ChecklistTemplate_organizationId_idx")
    @@index([organizationId, name], map: "ChecklistTemplate_organizationId_name_idx")
    @@map("ChecklistTemplate")
  }

  model ChecklistTemplateItem {
    id          String            @id(map: "ChecklistTemplateItem_pkey") @default(cuid(2))
    templateId  String
    title       String
    description String?
    position    Int               @default(0)
    required    Boolean           @default(false)
    createdAt   Timestamp(3)      @default(now())
    updatedAt   Timestamp(3)
    template    ChecklistTemplate @relation(fields:[templateId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "ChecklistTemplateItem_templateId_fkey")

    @@index([templateId], map: "ChecklistTemplateItem_templateId_idx")
    @@index([templateId, position], map: "ChecklistTemplateItem_templateId_position_idx")
    @@map("ChecklistTemplateItem")
  }

  model CrewMember {
    id                     String                  @id(map: "CrewMember_pkey") @default(cuid(2))
    organizationId         String
    firstName              String
    lastName               String?
    email                  String?
    phone                  String?
    hourlyCostCents        Int
    active                 Boolean                 @default(true)
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    dailyCapacityMinutes   Int?
    currency               String
    jobScheduleCrewMembers JobScheduleCrewMember[]
    jobTimeEntries         JobTimeEntry[]
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CrewMember_organizationId_fkey")

    @@index([organizationId, active], map: "CrewMember_organizationId_active_idx")
    @@index([organizationId], map: "CrewMember_organizationId_idx")
    @@map("CrewMember")
  }

  model Customer {
    id                     String                  @id(map: "Customer_pkey") @default(cuid(2))
    organizationId         String
    firstName              String
    lastName               String?
    companyName            String?
    email                  String?
    phone                  String?
    notes                  String?
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    archivedAt             Timestamp(3)?
    customerActivities     CustomerActivity[]
    customerCommunications CustomerCommunication[]
    customerInternalNotes  CustomerInternalNote[]
    estimates              Estimate[]
    invoices               Invoice[]
    jobs                   Job[]
    payments               Payment[]
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Customer_organizationId_fkey")

    @@index([organizationId, archivedAt], map: "Customer_organizationId_archivedAt_idx")
    @@index([organizationId, email], map: "Customer_organizationId_email_idx")
    @@index([organizationId], map: "Customer_organizationId_idx")
    @@map("Customer")
  }

  model User {
    id                                        String                  @id(map: "User_pkey") @default(cuid(2))
    email                                     String
    firstName                                 String?
    lastName                                  String?
    emailVerified                             Timestamp(3)?
    imageUrl                                  String?
    createdAt                                 Timestamp(3)            @default(now())
    updatedAt                                 Timestamp(3)
    clerkUserId                               String
    customerActivities                        CustomerActivity[]
    customerCommunications                    CustomerCommunication[]
    estimates                                 Estimate[]
    invoices                                  Invoice[]
    jobs                                      Job[]
    jobChecklists                             JobChecklist[]
    jobChecklistItems                         JobChecklistItem[]
    jobCosts                                  JobCost[]
    jobDocuments                              JobDocument[]
    jobMaterials                              JobMaterial[]
    jobNotes                                  JobNote[]
    jobPhotos                                 JobPhoto[]
    jobSchedules                              JobSchedule[]
    jobTasks                                  JobTask[]
    jobTimeEntries                            JobTimeEntry[]
    memberships                               Membership[]
    payments                                  Payment[]
    customerInternalNotes                     CustomerInternalNote[]  @relation(name: "CustomerInternalNote_assignedToUserId_fkey")
    customerInternalNotesCustomerInternalNote CustomerInternalNote[]  @relation(name: "CustomerInternalNote_completedByUserId_fkey")
    customerInternalNotes2                    CustomerInternalNote[]  @relation(name: "CustomerInternalNote_createdByUserId_fkey")
    notifications                             Notification[]          @relation(name: "Notification_actorUserId_fkey")
    notificationsNotification                 Notification[]          @relation(name: "Notification_recipientUserId_fkey")

    @@index([clerkUserId], map: "User_clerkUserId_key", unique: true)
    @@index([email], map: "User_email_key", unique: true)
    @@map("User")
  }

  model CustomerActivity {
    id             String                        @id(map: "CustomerActivity_pkey") @default(cuid(2))
    organizationId String
    customerId     String
    actorUserId    String?
    _type          pg.enum(CustomerActivityType) @map("type")
    title          String
    description    String?
    metadata       Jsonb?
    createdAt      Timestamp(3)                  @default(now())
    actorUser      User?                         @relation(fields:[actorUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerActivity_actorUserId_fkey")
    customer       Customer                      @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerActivity_customerId_fkey", index: false)
    organization   Organization                  @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerActivity_organizationId_fkey")

    @@index([actorUserId], map: "CustomerActivity_actorUserId_idx")
    @@index([customerId, createdAt], map: "CustomerActivity_customerId_createdAt_idx")
    @@index([organizationId], map: "CustomerActivity_organizationId_idx")
    @@index([_type], map: "CustomerActivity_type_idx")
    @@map("CustomerActivity")
  }

  model Job {
    id                     String                  @id(map: "Job_pkey") @default(cuid(2))
    organizationId         String
    customerId             String
    createdByUserId        String?
    name                   String
    description            String?
    status                 pg.enum(JobStatus)      @default("LEAD")
    priority               pg.enum(JobPriority)    @default("NORMAL")
    addressLine1           String?
    addressLine2           String?
    city                   String?
    province               String?
    postalCode             String?
    country                String                  @default("CA")
    startDate              Timestamp(3)?
    endDate                Timestamp(3)?
    budgetCents            Int?
    archivedAt             Timestamp(3)?
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    currency               String
    customerCommunications CustomerCommunication[]
    estimates              Estimate[]
    invoices               Invoice[]
    jobChecklists          JobChecklist[]
    jobContacts            JobContact[]
    jobCosts               JobCost[]
    jobDocuments           JobDocument[]
    jobMaterials           JobMaterial[]
    jobNotes               JobNote[]
    jobPhotos              JobPhoto[]
    jobSchedules           JobSchedule[]
    jobTasks               JobTask[]
    jobTimeEntries         JobTimeEntry[]
    createdByUser          User?                   @relation(fields:[createdByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Job_createdByUserId_fkey")
    customer               Customer                @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Job_customerId_fkey")
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Job_organizationId_fkey")

    @@index([createdByUserId], map: "Job_createdByUserId_idx")
    @@index([customerId], map: "Job_customerId_idx")
    @@index([organizationId, archivedAt], map: "Job_organizationId_archivedAt_idx")
    @@index([organizationId], map: "Job_organizationId_idx")
    @@index([organizationId, status], map: "Job_organizationId_status_idx")
    @@map("Job")
  }

  model Estimate {
    id                     String                  @id(map: "Estimate_pkey") @default(cuid(2))
    organizationId         String
    customerId             String
    jobId                  String?
    createdByUserId        String?
    number                 String
    status                 pg.enum(EstimateStatus) @default("DRAFT")
    title                  String?
    notes                  String?
    terms                  String?
    validUntil             Timestamp(3)?
    subtotalCents          Int                     @default(0)
    discountCents          Int                     @default(0)
    taxRate                Numeric(7, 4)           @default(0)
    taxCents               Int                     @default(0)
    totalCents             Int                     @default(0)
    sentAt                 Timestamp(3)?
    viewedAt               Timestamp(3)?
    approvedAt             Timestamp(3)?
    declinedAt             Timestamp(3)?
    expiredAt              Timestamp(3)?
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    publicAccessCreatedAt  Timestamp(3)?
    publicAccessToken      String?
    currency               String
    customerCommunications CustomerCommunication[]
    estimateLineItems      EstimateLineItem[]
    estimateReminders      EstimateReminder[]
    invoices               Invoice[]
    createdByUser          User?                   @relation(fields:[createdByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Estimate_createdByUserId_fkey")
    customer               Customer                @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Estimate_customerId_fkey")
    job                    Job?                    @relation(fields:[jobId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Estimate_jobId_fkey")
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Estimate_organizationId_fkey")

    @@index([createdByUserId], map: "Estimate_createdByUserId_idx")
    @@index([customerId], map: "Estimate_customerId_idx")
    @@index([jobId], map: "Estimate_jobId_idx")
    @@index([organizationId, createdAt], map: "Estimate_organizationId_createdAt_idx")
    @@index([organizationId], map: "Estimate_organizationId_idx")
    @@index([organizationId, number], map: "Estimate_organizationId_number_key", unique: true)
    @@index([organizationId, status], map: "Estimate_organizationId_status_idx")
    @@index([publicAccessToken], map: "Estimate_publicAccessToken_key", unique: true)
    @@index([validUntil], map: "Estimate_validUntil_idx")
    @@map("Estimate")
  }

  model Invoice {
    id                     String                  @id(map: "Invoice_pkey") @default(cuid(2))
    organizationId         String
    customerId             String
    jobId                  String?
    sourceEstimateId       String?
    createdByUserId        String?
    number                 String
    status                 pg.enum(InvoiceStatus)  @default("DRAFT")
    title                  String?
    notes                  String?
    terms                  String?
    currency               String
    issueDate              Timestamp(3)            @default(now())
    dueDate                Timestamp(3)?
    subtotalCents          Int                     @default(0)
    discountCents          Int                     @default(0)
    taxRate                Numeric(7, 4)           @default(0)
    taxCents               Int                     @default(0)
    totalCents             Int                     @default(0)
    amountPaidCents        Int                     @default(0)
    balanceDueCents        Int                     @default(0)
    sentAt                 Timestamp(3)?
    viewedAt               Timestamp(3)?
    paidAt                 Timestamp(3)?
    overdueAt              Timestamp(3)?
    voidedAt               Timestamp(3)?
    createdAt              Timestamp(3)            @default(now())
    updatedAt              Timestamp(3)
    publicAccessCreatedAt  Timestamp(3)?
    publicAccessToken      String?
    customerCommunications CustomerCommunication[]
    invoiceLineItems       InvoiceLineItem[]
    invoiceReminders       InvoiceReminder[]
    payments               Payment[]
    createdByUser          User?                   @relation(fields:[createdByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Invoice_createdByUserId_fkey")
    customer               Customer                @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Invoice_customerId_fkey")
    job                    Job?                    @relation(fields:[jobId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Invoice_jobId_fkey")
    organization           Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Invoice_organizationId_fkey")
    sourceEstimate         Estimate?               @relation(fields:[sourceEstimateId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Invoice_sourceEstimateId_fkey")

    @@index([createdByUserId], map: "Invoice_createdByUserId_idx")
    @@index([customerId], map: "Invoice_customerId_idx")
    @@index([dueDate], map: "Invoice_dueDate_idx")
    @@index([jobId], map: "Invoice_jobId_idx")
    @@index([organizationId, createdAt], map: "Invoice_organizationId_createdAt_idx")
    @@index([organizationId], map: "Invoice_organizationId_idx")
    @@index([organizationId, number], map: "Invoice_organizationId_number_key", unique: true)
    @@index([organizationId, status], map: "Invoice_organizationId_status_idx")
    @@index([publicAccessToken], map: "Invoice_publicAccessToken_key", unique: true)
    @@index([sourceEstimateId], map: "Invoice_sourceEstimateId_idx")
    @@map("Invoice")
  }

  model Payment {
    id                      String                  @id(map: "Payment_pkey") @default(cuid(2))
    organizationId          String
    customerId              String
    invoiceId               String
    recordedByUserId        String?
    status                  pg.enum(PaymentStatus)  @default("RECORDED")
    method                  pg.enum(PaymentMethod)  @default("OTHER")
    amountCents             Int
    reference               String?
    notes                   String?
    receivedAt              Timestamp(3)            @default(now())
    voidedAt                Timestamp(3)?
    createdAt               Timestamp(3)            @default(now())
    updatedAt               Timestamp(3)
    externalPaymentId       String?
    provider                String?
    stripeCheckoutSessionId String?
    stripePaymentIntentId   String?
    currency                String
    customerCommunications  CustomerCommunication[]
    paymentReceiptDelivery  PaymentReceiptDelivery?
    customer                Customer                @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Payment_customerId_fkey")
    invoice                 Invoice                 @relation(fields:[invoiceId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Payment_invoiceId_fkey")
    organization            Organization            @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Payment_organizationId_fkey")
    recordedByUser          User?                   @relation(fields:[recordedByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "Payment_recordedByUserId_fkey")

    @@index([customerId], map: "Payment_customerId_idx")
    @@index([invoiceId], map: "Payment_invoiceId_idx")
    @@index([invoiceId, receivedAt], map: "Payment_invoiceId_receivedAt_idx")
    @@index([organizationId], map: "Payment_organizationId_idx")
    @@index([organizationId, status], map: "Payment_organizationId_status_idx")
    @@index([provider, externalPaymentId], map: "Payment_provider_externalPaymentId_key", unique: true)
    @@index([recordedByUserId], map: "Payment_recordedByUserId_idx")
    @@index([stripeCheckoutSessionId], map: "Payment_stripeCheckoutSessionId_idx")
    @@index([stripePaymentIntentId], map: "Payment_stripePaymentIntentId_idx")
    @@map("Payment")
  }

  model CustomerCommunication {
    id                String                          @id(map: "CustomerCommunication_pkey") @default(cuid(2))
    organizationId    String
    customerId        String
    actorUserId       String?
    jobId             String?
    estimateId        String?
    invoiceId         String?
    paymentId         String?
    channel           pg.enum(CommunicationChannel)   @default("EMAIL")
    direction         pg.enum(CommunicationDirection) @default("OUTBOUND")
    category          pg.enum(CommunicationCategory)
    status            pg.enum(CommunicationStatus)    @default("PENDING")
    recipientEmail    String
    subject           String
    textBody          String
    htmlBody          String
    provider          String?
    providerMessageId String?
    errorMessage      String?
    sentAt            Timestamp(3)?
    createdAt         Timestamp(3)                    @default(now())
    updatedAt         Timestamp(3)
    actorUser         User?                           @relation(fields:[actorUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerCommunication_actorUserId_fkey")
    customer          Customer                        @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerCommunication_customerId_fkey", index: false)
    estimate          Estimate?                       @relation(fields:[estimateId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerCommunication_estimateId_fkey")
    invoice           Invoice?                        @relation(fields:[invoiceId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerCommunication_invoiceId_fkey")
    job               Job?                            @relation(fields:[jobId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerCommunication_jobId_fkey")
    organization      Organization                    @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerCommunication_organizationId_fkey")
    payment           Payment?                        @relation(fields:[paymentId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerCommunication_paymentId_fkey")

    @@index([actorUserId], map: "CustomerCommunication_actorUserId_idx")
    @@index([customerId, createdAt], map: "CustomerCommunication_customerId_createdAt_idx")
    @@index([estimateId], map: "CustomerCommunication_estimateId_idx")
    @@index([invoiceId], map: "CustomerCommunication_invoiceId_idx")
    @@index([jobId], map: "CustomerCommunication_jobId_idx")
    @@index([organizationId, category], map: "CustomerCommunication_organizationId_category_idx")
    @@index([organizationId, createdAt], map: "CustomerCommunication_organizationId_createdAt_idx")
    @@index([organizationId], map: "CustomerCommunication_organizationId_idx")
    @@index([organizationId, status], map: "CustomerCommunication_organizationId_status_idx")
    @@index([paymentId], map: "CustomerCommunication_paymentId_idx")
    @@index([providerMessageId], map: "CustomerCommunication_providerMessageId_key", unique: true)
    @@map("CustomerCommunication")
  }

  model CustomerInternalNote {
    id                String                            @id(map: "CustomerInternalNote_pkey") @default(cuid(2))
    organizationId    String
    customerId        String
    createdByUserId   String?
    kind              pg.enum(CustomerInternalNoteKind) @default("NOTE")
    content           String
    assignedToUserId  String?
    dueAt             Timestamp(3)?
    completedAt       Timestamp(3)?
    completedByUserId String?
    createdAt         Timestamp(3)                      @default(now())
    updatedAt         Timestamp(3)
    notifications     Notification[]
    assignedToUser    User?                             @relation(name: "CustomerInternalNote_assignedToUserId_fkey", fields:[assignedToUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerInternalNote_assignedToUserId_fkey")
    completedByUser   User?                             @relation(name: "CustomerInternalNote_completedByUserId_fkey", fields:[completedByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerInternalNote_completedByUserId_fkey")
    createdByUser     User?                             @relation(name: "CustomerInternalNote_createdByUserId_fkey", fields:[createdByUserId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "CustomerInternalNote_createdByUserId_fkey")
    customer          Customer                          @relation(fields:[customerId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerInternalNote_customerId_fkey", index: false)
    organization      Organization                      @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "CustomerInternalNote_organizationId_fkey")

    @@index([assignedToUserId, dueAt], map: "CustomerInternalNote_assignedToUserId_dueAt_idx")
    @@index([assignedToUserId], map: "CustomerInternalNote_assignedToUserId_idx")
    @@index([completedByUserId], map: "CustomerInternalNote_completedByUserId_idx")
    @@index([createdByUserId], map: "CustomerInternalNote_createdByUserId_idx")
    @@index([customerId, completedAt], map: "CustomerInternalNote_customerId_completedAt_idx")
    @@index([customerId, createdAt], map: "CustomerInternalNote_customerId_createdAt_idx")
    @@index([organizationId, dueAt], map: "CustomerInternalNote_organizationId_dueAt_idx")
    @@index([organizationId], map: "CustomerInternalNote_organizationId_idx")
    @@index([organizationId, kind], map: "CustomerInternalNote_organizationId_kind_idx")
    @@map("CustomerInternalNote")
  }

  model DispatchSettings {
    id                              String                   @id(map: "DispatchSettings_pkey") @default(cuid(2))
    organizationId                  String
    defaultStartHour                Int                      @default(9)
    defaultStartMinute              Int                      @default(0)
    defaultDurationMinutes          Int                      @default(60)
    defaultScheduleType             pg.enum(JobScheduleType) @default("WORK")
    createdAt                       Timestamp(3)             @default(now())
    updatedAt                       Timestamp(3)
    defaultCrewDailyCapacityMinutes Int                      @default(480)
    organization                    Organization             @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "DispatchSettings_organizationId_fkey")

    @@unique([organizationId], map: "DispatchSettings_organizationId_key")
    @@map("DispatchSettings")
  }

  model EstimateLineItem {
    id                  String         @id(map: "EstimateLineItem_pkey") @default(cuid(2))
    estimateId          String
    description         String
    quantity            Numeric(12, 4) @default(1)
    unitPriceCents      Int
    lineTotalCents      Int
    position            Int            @default(0)
    createdAt           Timestamp(3)   @default(now())
    updatedAt           Timestamp(3)
    sourceJobMaterialId String?
    estimate            Estimate       @relation(fields:[estimateId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "EstimateLineItem_estimateId_fkey")

    @@index([estimateId], map: "EstimateLineItem_estimateId_idx")
    @@index([estimateId, position], map: "EstimateLineItem_estimateId_position_idx")
    @@index([sourceJobMaterialId], map: "EstimateLineItem_sourceJobMaterialId_idx")
    @@map("EstimateLineItem")
  }

  model EstimateReminder {
    id             String                        @id(map: "EstimateReminder_pkey") @default(cuid(2))
    organizationId String
    estimateId     String
    _type          pg.enum(EstimateReminderType) @map("type")
    scheduledFor   Timestamp(3)
    sentAt         Timestamp(3)?
    createdAt      Timestamp(3)                  @default(now())
    updatedAt      Timestamp(3)
    estimate       Estimate                      @relation(fields:[estimateId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "EstimateReminder_estimateId_fkey")
    organization   Organization                  @relation(fields:[organizationId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "EstimateReminder_organizationId_fkey")

