generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  OFFICE
  VIEWER
}

enum CustomerActivityType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  CUSTOMER_ARCHIVED
  CUSTOMER_RESTORED
  NOTE_ADDED

  JOB_CREATED
  JOB_UPDATED
  JOB_ARCHIVED
  JOB_RESTORED

  JOB_MATERIAL_CREATED
  JOB_MATERIAL_UPDATED
  JOB_MATERIAL_DELETED

  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DELETED

  JOB_COST_CREATED
  JOB_COST_UPDATED
  JOB_COST_DELETED

  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_CANCELLED
  SCHEDULE_RESTORED

  ESTIMATE_CREATED
  ESTIMATE_UPDATED
  ESTIMATE_SENT
  ESTIMATE_VIEWED
  ESTIMATE_APPROVED
  ESTIMATE_DECLINED
  ESTIMATE_EXPIRED

  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_SENT
  INVOICE_VIEWED
  INVOICE_PARTIALLY_PAID
  INVOICE_PAID
  INVOICE_OVERDUE
  INVOICE_VOIDED

  PAYMENT_RECEIVED
  PAYMENT_VOIDED

  DOCUMENT_ADDED
  PHOTO_ADDED
  AI_ACTIVITY
}

enum JobStatus {
  LEAD
  ESTIMATING
  APPROVED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum JobTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum JobScheduleType {
  WORK
  SITE_VISIT
  ESTIMATE
  INSPECTION
  DELIVERY
  MEETING
  OTHER
}

enum JobScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum PaymentMethod {
  CASH
  CHEQUE
  CREDIT_CARD
  DEBIT_CARD
  E_TRANSFER
  BANK_TRANSFER
  OTHER
}

enum InvoiceReminderType {
  BEFORE_DUE
  DUE_TODAY
  FIRST_OVERDUE
  SECOND_OVERDUE
}

enum EstimateReminderType {
  FIRST_FOLLOW_UP
  SECOND_FOLLOW_UP
}

enum PaymentReceiptStatus {
  PENDING
  SENT
  FAILED
}

enum JobCostCategory {
  MATERIAL
  LABOR
  SUBCONTRACTOR
  EQUIPMENT
  PERMIT
  TRAVEL
  OTHER
}

enum JobMaterialStatus {
  REQUIRED
  ORDERED
  RECEIVED
  CANCELLED
}

enum JobMaterialUnit {
  EACH
  FOOT
  METER
  SQUARE_FOOT
  SQUARE_METER
  CUBIC_FOOT
  CUBIC_METER
  POUND
  KILOGRAM
  LITER
  GALLON
  BOX
  BAG
  BUNDLE
  ROLL
  SHEET
  OTHER
}

model User {
  id            String    @id @default(cuid())
  clerkUserId   String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  emailVerified DateTime?
  imageUrl      String?

  memberships           Membership[]
  customerActivities    CustomerActivity[]
  createdJobs           Job[]
  createdJobTasks       JobTask[]
  createdSchedules      JobSchedule[]
  createdEstimates      Estimate[]
  createdInvoices       Invoice[]
  recordedPayments      Payment[]
  createdJobCosts       JobCost[]
  createdJobMaterials   JobMaterial[]
  createdJobTimeEntries JobTimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  role OrganizationRole @default(VIEWER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, role])
}

model Organization {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  legalName String?
  email     String?
  phone     String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String  @default("CA")

  taxNumber String?
  website   String?
  logoUrl   String?

  timezone String @default("America/Edmonton")
  currency String @default("CAD")

  nextEstimateNumber Int @default(1)
  nextInvoiceNumber  Int @default(1)

  memberships              Membership[]
  customers                Customer[]
  customerActivities       CustomerActivity[]
  jobs                     Job[]
  jobTasks                 JobTask[]
  jobSchedules             JobSchedule[]
  jobCosts                 JobCost[]
  estimates                Estimate[]
  jobMaterials             JobMaterial[]
  crewMembers              CrewMember[]
  jobTimeEntries           JobTimeEntry[]
  invoices                 Invoice[]
  payments                 Payment[]
  invoiceReminderSettings  InvoiceReminderSettings?
  invoiceReminders         InvoiceReminder[]
  estimateReminders        EstimateReminder[]
  estimateReminderSettings EstimateReminderSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceReminderSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  beforeDueEnabled Boolean @default(true)
  beforeDueDays    Int     @default(3)

  dueTodayEnabled Boolean @default(true)

  firstOverdueEnabled Boolean @default(true)
  firstOverdueDays    Int     @default(3)

  secondOverdueEnabled Boolean @default(true)
  secondOverdueDays    Int     @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceReminder {
  id             String @id @default(cuid())
  organizationId String
  invoiceId      String

  type InvoiceReminderType

  scheduledFor DateTime
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, type])
  @@index([organizationId])
  @@index([invoiceId])
  @@index([scheduledFor])
  @@index([sentAt])
}

model Customer {
  id             String @id @default(cuid())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String?
  companyName String?
  email       String?
  phone       String?
  notes       String?

  archivedAt DateTime?

  activities CustomerActivity[]
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, archivedAt])
}

model CustomerActivity {
  id             String               @id @default(cuid())
  organizationId String
  customerId     String
  actorUserId    String?
  type           CustomerActivityType
  title          String
  description    String?
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([customerId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model Job {
  id              String  @id @default(cuid())
  organizationId  String
  customerId      String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  name        String
  description String?

  status   JobStatus   @default(LEAD)
  priority JobPriority @default(NORMAL)

  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String  @default("CA")

  startDate DateTime?
  endDate   DateTime?

  budgetCents Int?

  archivedAt DateTime?

  tasks       JobTask[]
  schedules   JobSchedule[]
  costs       JobCost[]
  materials   JobMaterial[]
  timeEntries JobTimeEntry[]
  estimates   Estimate[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([createdByUserId])
}

model JobCost {
  id              String  @id @default(cuid())
  organizationId  String
  jobId           String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  category JobCostCategory

  description String
  amountCents Int

  incurredAt DateTime @default(now())

  vendor    String?
  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([createdByUserId])
  @@index([organizationId, category])
  @@index([organizationId, incurredAt])
  @@index([jobId, incurredAt])
}

model JobTask {
  id              String  @id @default(cuid())
  organizationId  String
  jobId           String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  title       String
  description String?

  status   JobTaskStatus   @default(TODO)
  priority JobTaskPriority @default(NORMAL)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([jobId, status])
  @@index([createdByUserId])
  @@index([dueDate])
}

model JobSchedule {
  id              String  @id @default(cuid())
  organizationId  String
  jobId           String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  type   JobScheduleType   @default(WORK)
  status JobScheduleStatus @default(SCHEDULED)

  title       String
  description String?

  startAt DateTime
  endAt   DateTime?
  allDay  Boolean   @default(false)

  location String?
  notes    String?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([organizationId, startAt])
  @@index([jobId, startAt])
  @@index([organizationId, status])
  @@index([createdByUserId])
}

model Estimate {
  id              String  @id @default(cuid())
  organizationId  String
  customerId      String
  jobId           String?
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  number String

  status EstimateStatus @default(DRAFT)

  title String?

  notes String?
  terms String?

  validUntil DateTime?

  subtotalCents Int @default(0)
  discountCents Int @default(0)

  taxRate Decimal @default(0) @db.Decimal(7, 4)

  taxCents   Int @default(0)
  totalCents Int @default(0)

  sentAt     DateTime?
  viewedAt   DateTime?
  approvedAt DateTime?
  declinedAt DateTime?
  expiredAt  DateTime?

  /**
   * Customer-facing estimate portal.
   * This is a cryptographically random opaque token and must never be
   * derived from the estimate ID, estimate number, customer ID, or other
   * predictable values.
   * Draft estimates have no public token. A token is created when the
   * estimate is successfully sent to the customer.
   */
  publicAccessToken     String?   @unique
  publicAccessCreatedAt DateTime?

  lineItems EstimateLineItem[]
  invoices  Invoice[]
  reminders EstimateReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([jobId])
  @@index([createdByUserId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([validUntil])
}

model EstimateLineItem {
  id         String @id @default(cuid())
  estimateId String

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  description String

  quantity Decimal @default(1) @db.Decimal(12, 4)

  unitPriceCents Int
  lineTotalCents Int

  sourceJobMaterialId String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimateId])
  @@index([estimateId, position])
  @@index([sourceJobMaterialId])
}

model EstimateReminderSettings {
  id             String @id @default(cuid())
  organizationId String @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  firstFollowUpEnabled Boolean @default(true)
  firstFollowUpDays    Int     @default(3)

  secondFollowUpEnabled Boolean @default(true)
  secondFollowUpDays    Int     @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimateReminder {
  id             String @id @default(cuid())
  organizationId String
  estimateId     String

  type EstimateReminderType

  scheduledFor DateTime
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  estimate     Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@unique([estimateId, type])
  @@index([organizationId])
  @@index([estimateId])
  @@index([scheduledFor])
  @@index([sentAt])
}

model Invoice {
  id               String  @id @default(cuid())
  organizationId   String
  customerId       String
  jobId            String?
  sourceEstimateId String?
  createdByUserId  String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job            Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sourceEstimate Estimate?    @relation(fields: [sourceEstimateId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  number String

  status InvoiceStatus @default(DRAFT)

  title String?

  notes String?
  terms String?

  currency String @default("CAD")

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotalCents Int @default(0)
  discountCents Int @default(0)

  taxRate Decimal @default(0) @db.Decimal(7, 4)

  taxCents Int @default(0)

  totalCents      Int @default(0)
  amountPaidCents Int @default(0)
  balanceDueCents Int @default(0)

  sentAt    DateTime?
  viewedAt  DateTime?
  paidAt    DateTime?
  overdueAt DateTime?
  voidedAt  DateTime?

  /**
   * Customer-facing invoice portal.
   * This is a cryptographically random opaque token and must never be
   * derived from the invoice ID, invoice number, customer ID, or other
   * predictable values.
   * Draft invoices have no public token. A token is created when the
   * invoice is successfully sent.
   */
  publicAccessToken     String?   @unique
  publicAccessCreatedAt DateTime?

  lineItems InvoiceLineItem[]
  payments  Payment[]
  reminders InvoiceReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([jobId])
  @@index([sourceEstimateId])
  @@index([createdByUserId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([dueDate])
}

model InvoiceLineItem {
  id                  String  @id @default(cuid())
  invoiceId           String
  sourceJobMaterialId String?

  invoice           Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sourceJobMaterial JobMaterial? @relation(fields: [sourceJobMaterialId], references: [id], onDelete: SetNull)

  description String

  quantity Decimal @default(1) @db.Decimal(12, 4)

  unitPriceCents Int
  lineTotalCents Int

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, sourceJobMaterialId])
  @@index([invoiceId])
  @@index([invoiceId, position])
  @@index([sourceJobMaterialId])
}

model Payment {
  id               String  @id @default(cuid())
  organizationId   String
  customerId       String
  invoiceId        String
  recordedByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  receiptDelivery PaymentReceiptDelivery?

  status PaymentStatus @default(RECORDED)
  method PaymentMethod @default(OTHER)

  amountCents Int

  reference String?
  notes     String?

  /**
   * External payment-provider identifiers.
   * These remain null for manually recorded payments.
   */
  provider                String?
  externalPaymentId       String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  receivedAt DateTime  @default(now())
  voidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * Database-enforced payment idempotency.
   * Manual payments have null provider/externalPaymentId values.
   */
  @@unique([provider, externalPaymentId])
  @@index([organizationId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([recordedByUserId])
  @@index([organizationId, status])
  @@index([invoiceId, receivedAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

model PaymentReceiptDelivery {
  id        String @id @default(cuid())
  paymentId String @unique

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  status PaymentReceiptStatus @default(PENDING)

  attempts Int @default(0)

  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  sentAt DateTime?

  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([nextAttemptAt])
  @@index([status, nextAttemptAt])
}

model StripeWebhookEvent {
  id String @id @default(cuid())

  stripeEventId String @unique
  eventType     String

  /**
   * Stripe object that the event refers to.
   * For Checkout events this will normally be cs_...
   */
  objectId String?

  processedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([objectId])
  @@index([processedAt])
}

model JobMaterial {
  id              String  @id @default(cuid())
  organizationId  String
  jobId           String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  invoiceLineItems InvoiceLineItem[]

  name        String
  description String?

  quantity Decimal         @default(1) @db.Decimal(12, 3)
  unit     JobMaterialUnit @default(EACH)

  supplier  String?
  sku       String?
  reference String?
  notes     String?

  estimatedUnitCostCents Int?
  actualUnitCostCents    Int?
  billableUnitPriceCents Int?

  status JobMaterialStatus @default(REQUIRED)

  orderedAt  DateTime?
  receivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([createdByUserId])
  @@index([organizationId, status])
  @@index([jobId, status])
}

model CrewMember {
  id             String @id @default(cuid())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?

  email String?
  phone String?

  hourlyCostCents Int

  active Boolean @default(true)

  timeEntries JobTimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, active])
}

model JobTimeEntry {
  id              String  @id @default(cuid())
  organizationId  String
  jobId           String
  crewMemberId    String
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crewMember   CrewMember   @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  startedAt DateTime
  endedAt   DateTime?

  hourlyCostCents Int
  laborCostCents  Int @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([jobId])
  @@index([crewMemberId])
  @@index([createdByUserId])
  @@index([jobId, startedAt])
}
