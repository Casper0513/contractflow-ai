{
  "name": "@contractflow/invoice-pdf",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts --format cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --config ../../eslint.config.mjs --max-warnings=0",
    "test": "echo \"No invoice PDF package tests yet\""
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
